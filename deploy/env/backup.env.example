DATABASE_URL=postgres://rust_toon:replace-me@127.0.0.1:5432/rust_toon
BACKUP_DIR=/var/backups/rust-toon/postgresql
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=rust_toon
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=rust-toon
MINIO_BACKUP_DIR=/var/backups/rust-toon/minio
CONSISTENT_BACKUP_DIR=/var/backups/rust-toon/sets
# The consistent backup service stops these units in reverse order and starts
# only the units that were active before the snapshot.
BACKUP_SYSTEMD_UNITS="rust-toon-gateway.service rust-toon-worker.service"
BACKUP_RETENTION_DAYS=14
